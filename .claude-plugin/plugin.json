{
  "author": {
    "name": "brandonh-msft",
    "url": "https://github.com/brandonh-msft"
  },
  "name": "session-registry",
  "version": "1.6.0",
  "keywords": [
    "sessions",
    "publishing",
    "collaboration",
    "debugging",
    "development"
  ],
  "description": "Capture, scan, publish, and share native AI agent sessions securely.",
  "homepage": "https://sessionregistry.io",
  "repository": "https://github.com/brandonh-msft/plugin-session_registry",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Session Registry",
        "shortDescription": "Capture, scan, publish, and share native AI agent sessions securely.",
        "developerName": "brandonh-msft",
        "websiteURL": "https://sessionregistry.io",
        "logo": "./assets/session-registry-logo.png",
        "composerIcon": "./assets/session-registry-logo.png"
      }
    }
  },
  "mcpServers": {
    "session-registry": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/server.mjs"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "env": {
        "SESSION_REGISTRY_API_URL": "https://sessionregistry.io"
      },
      "timeout": 2147483647
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_session-registry_)?session-registry__(save_session|prepare_session_capture|publish_session)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/server.mjs\" --claude-current-session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
